<mxfile host="app.diagrams.net"><diagram id="crc-v3" name="CRC Diagram V3"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="crc3-3" value="DegreePlan" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="190" y="40" width="460" height="280" as="geometry"/></mxCell><mxCell id="crc3-4" value="Add and remove courses in each quarter of the 4-year plan" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc3-3"><mxGeometry x="0" y="30" width="460" height="30" as="geometry"/></mxCell><mxCell id="crc3-5" value="Only accept offered courses, each course once, and at most 18 units per quarter" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc3-3"><mxGeometry x="0" y="60" width="460" height="30" as="geometry"/></mxCell><mxCell id="crc3-6" value="Track completed courses" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc3-3"><mxGeometry x="0" y="90" width="460" height="30" as="geometry"/></mxCell><mxCell id="crc3-7" value="Warn when a course is placed before its prerequisites" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;o