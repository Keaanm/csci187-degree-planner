"text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="c17"><mxGeometry x="0" y="30" width="410" height="30" as="geometry"/></mxCell><mxCell id="c19" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="c17"><mxGeometry x="0" y="60" width="410" height="10" as="geometry"/></mxCell><mxCell id="c20" value="Knows: course code, title, units, description, prerequisite courses (any one course in an either/or group is enough)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="c17"><mxGeometry x="0" y="70" width="410" height="60" as="geometry"/></mxCell><mxCell id="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c12" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c17" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c17" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Changes from V2&lt;/b&gt;&lt;br&gt;• QuarterSchedule is merged into DegreePlan, which holds the courses for each quarter.&lt;br&gt;• CourseOffering is removed: which quarters a course is offered is not in the MVP (see Later in REQUIREMENTS.md).&lt;br&gt;• DegreePlan now tracks completed courses and units remaining." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="1060" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>