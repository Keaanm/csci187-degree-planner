;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="460" height="142" as="geometry"/></mxCell><mxCell id="c13" value="Determine whether a set of courses satisfies the requirement" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontColor=#000000;" vertex="1" parent="c12"><mxGeometry x="0" y="30" width="460" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Determine how many more courses are needed and which are missing" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontColor=#000000;" vertex="1" parent="c12"><mxGeometry x="0" y="56" width="460" height="26" as="geometry"/></mxCell><mxCell id="c15" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontColor=#000000;" vertex="1" parent="c12"><mxGeometry x="0" y="82" width="460" height="8" as="geometry"/></mxCell><mxCell id="c16" value="Knows: requirement description, courses that satisfy the requirement, how many of them are needed" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontColor=#000000;" vertex="1" parent="c12"><mxGeometry x="0" y="90" width="460" height="52" as="geometry"/></mxCell><mxCell id="c17" value="Course" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="420" width="460" height="116" as="geometry"/></mxCell><mxCell id="c18" value="Provide course description and prerequisite information" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontColor=#000000;" vertex="1" parent="c17"><mxGeometry x="0" y="30" width="460" height="26" as="geometry"/></mxCell><mxCell id="c19" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontColor=#000000;" vertex="1" parent="c17"><mxGeometry x="0" y="56" width="460" height="8" as="geometry"/></mxCell><mxCell id="c20" value="Knows: course code, title, units, description, prerequisite courses (any one course in an either/or group is enough)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontColor=#000000;" vertex="1" parent="c17"><mxGeometry x="0" y="64" width="460" height="52" as="geometry"/></mxCell><mxCell id="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="c12" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="c17" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="c17" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Changes from V2&lt;/b&gt;&lt;br&gt;• QuarterSchedule is merged into DegreePlan, which holds the courses for each quarter.&lt;br&gt;• CourseOffering is removed: which quarters a course is offered is not in the MVP (see Later in REQUIREMENTS.md).&lt;br&gt;• DegreePlan now tracks completed courses and units remaining." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="1060" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>