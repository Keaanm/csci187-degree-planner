"30" as="geometry"/></mxCell><mxCell id="crc3-18" value="Determine how many more courses are needed and which are missing" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc3-16"><mxGeometry x="0" y="60" width="405" height="30" as="geometry"/></mxCell><mxCell id="crc3-19" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc3-16"><mxGeometry x="0" y="90" width="405" height="10" as="geometry"/></mxCell><mxCell id="crc3-20" value="Knows: requirement description, courses that satisfy the requirement, how many of them are needed" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc3-16"><mxGeometry x="0" y="100" width="405" height="60" as="geometry"/></mxCell><mxCell id="crc3-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="crc3-16" target="crc3-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc3-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="crc3-12" target="crc3-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc3-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="crc3-12" target="crc3-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc3-24" value="&lt;b&gt;Changes from V2&lt;/b&gt;&lt;br&gt;• QuarterSchedule is merged into DegreePlan, which holds the courses for each quarter.&lt;br&gt;• CourseOffering is removed: which quarters a course is offered is not in the MVP (see Later in REQUIREMENTS.md).&lt;br&gt;• DegreePlan now tracks completed courses and units remaining." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="640" width="830" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>