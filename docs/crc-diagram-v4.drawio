rflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="crc4-11"><mxGeometry x="0" y="120" width="340" height="30" as="geometry"/></mxCell><mxCell id="crc4-16" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-11"><mxGeometry x="0" y="150" width="340" height="10" as="geometry"/></mxCell><mxCell id="crc4-17" value="Knows: the offered courses, the degree requirements" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-11"><mxGeometry x="0" y="160" width="340" height="60" as="geometry"/></mxCell><mxCell id="crc4-18" value="DegreeRequirement" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="10" y="430" width="405" height="160" as="geometry"/></mxCell><mxCell id="crc4-19" value="Determine whether a set of courses satisfies the requirement" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-18"><mxGeometry x="0" y="30" width="405" height="30" as="geometry"/></mxCell><mxCell id="crc4-20" value="Determine how many more courses are needed and which are missing" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-18"><mxGeometry x="0" y="60" width="405" height="30" as="geometry"/></mxCell><mxCell id="crc4-21" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-18"><mxGeometry x="0" y="90" width="405" height="10" as="geometry"/></mxCell><mxCell id="crc4-22" value="Knows: requirement description, courses that satisfy the requirement, how many of them are needed" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-18"><mxGeometry x="0" y="100" width="405" height="60" as="geometry"/></mxCell><mxCell id="crc4-23" value="Course" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="435" y="430" width="405" height="130" as="geometry"/></mxCell><mxCell id="crc4-24" value="Provide course description and prerequisite information" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-23"><mxGeometry x="0" y="30" width="405" height="30" as="geometry"/></mxCell><mxCell id="crc4-25" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-23"><mxGeometry x="0" y="60" width="405" height="10" as="geometry"/></mxCell><mxCell id="crc4-26" value="Knows: course code, title, units, description, prerequisite courses (any one course in an either/or group is enough)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-23"><mxGeometry x="0" y="70" width="405" height="60" as="geometry"/></mxCell><mxCell id="crc4-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="crc4-18" target="crc4-1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc4-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="crc4-23" target="crc4-1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc4-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="crc4-23" target="crc4-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc4-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="crc4-18" target="crc4-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc4-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="crc4-23" target="crc4-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc4-32" value="&lt;b&gt;Changes from V3&lt;/b&gt; (yellow)&lt;br&gt;• New Catalog class manages the course data: looking up a course, searching, which requirements a course satisfies, and which courses need it.&lt;br&gt;• DegreePlan saves the plan (as rows the backend stores) and loads it back.&lt;br&gt;• DegreePlan shows each requirement as completed, covered by the plan, or not covered.&lt;br&gt;• Units are counted against what the in-scope requirements need instead of 175." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="640" width="830" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
