<mxfile host="app.diagrams.net"><diagram id="crc-v4" name="CRC Diagram V4"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="crc4-1" value="DegreePlan" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="10" y="40" width="470" height="310" as="geometry"/></mxCell><mxCell id="crc4-2" value="Add and remove courses in each quarter of the 4-year plan" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-1"><mxGeometry x="0" y="30" width="470" height="30" as="geometry"/></mxCell><mxCell id="crc4-3" value="Only accept offered courses, each course once, and at most 18 units per quarter" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-1"><mxGeometry x="0" y="60" width="470" height="30" as="geometry"/></mxCell><mxCell id="crc4-4" value="Track which courses are completed" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-1"><mxGeometry x="0" y="90" width="470" height="30" as="geometry"/></mxCell><mxCell id="crc4-5" value="Warn when a course is placed before its prerequisites" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-1"><mxGeometry x="0" y="120" width="470" height="30" as="geometry"/></mxCell><mxCell id="crc4-6" value="Determine which requirements are completed, covered by the plan, or not covered" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="crc4-1"><mxGeometry x="0" y="150" width="470" height="30" as="geometry"/></mxCell><mxCell id="crc4-7" value="Count units completed and planned, and the units the requirements need" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="crc4-1"><mxGeometry x="0" y="180" width="470" height="30" as="geometry"/></mxCell><mxCell id="crc4-8" value="Save the plan: turn it into rows for the database and rebuild it from saved rows" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="crc4-1"><mxGeometry x="0" y="210" width="470" height="30" as="geometry"/></mxCell><mxCell id="crc4-9" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc4-1"><mxGeometry x="0" y="240" width="470" height="10" as="geometry"/></mxCell><mxCell id="crc4-10" value="Knows: the courses in each of the 12 quarters, which courses are completed, the offered courses" style="text;strokeColor=none;fill