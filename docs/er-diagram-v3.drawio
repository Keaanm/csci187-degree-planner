iteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="455" y="480" width="140" height="80" as="geometry"/></mxCell><mxCell id="er3-67" value="OtherCredit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="640" width="170" height="60" as="geometry"/></mxCell><mxCell id="er3-68" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-4" target="er3-66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-69" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-66" target="er3-67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-70" value="credit_id" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="340" y="770" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-71" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-67" target="er3-70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-72" value="title" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="790" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-73" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-67" target="er3-72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-74" value="units" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-75" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-67" target="er3-74"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-76" value="kind" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="600" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-77" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-67" target="er3-76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-78" value="quarter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="580" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-79" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-67" target="er3-78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-80" value="counts toward" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1455" y="630" width="140" height="80" as="geometry"/></mxCell><mxCell id="er3-81" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-67" target="er3-80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-82" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-80" target="er3-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-83" value="&lt;b&gt;Changes from V2&lt;/b&gt; (yellow), for the final project:&lt;br&gt;• &lt;b&gt;Student&lt;/b&gt; holds an account (email, hashed password) and the year they started, which decides which quarters are past. A student &lt;i&gt;owns&lt;/i&gt; their plans, replacing the single shared plan.&lt;br&gt;• &lt;b&gt;Session&lt;/b&gt; keeps a student logged in with a token that expires.&lt;br&gt;• &lt;i&gt;contains&lt;/i&gt; drops &lt;b&gt;status&lt;/b&gt; (completed now comes from the date) and adds &lt;b&gt;failed&lt;/b&gt;, so a course can appear again when it is retaken.&lt;br&gt;• &lt;b&gt;OtherCredit&lt;/b&gt; is University Core, elective and AP/transfer units (&lt;b&gt;kind&lt;/b&gt;), in a quarter or before SCU; it &lt;i&gt;counts toward&lt;/i&gt; unit-based requirements.&lt;br&gt;• &lt;b&gt;units&lt;/b&gt; on DegreeRequirement is for requirements measured in units, like the Core." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="720" width="560" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
