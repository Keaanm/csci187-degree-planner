<mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-86" value="credit_id" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="230" y="650" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-87" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-81" target="er3-86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-88" value="quarter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="730" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-89" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-81" target="er3-88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-90" value="units" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="800" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-91" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-81" target="er3-90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-92" value="title" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="800" width="120" height="44" as="geometry"/></mxCell><mxCell id="er3-93" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-81" target="er3-92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-94" value="counts toward" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1455" y="630" width="140" height="80" as="geometry"/></mxCell><mxCell id="er3-95" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-81" target="er3-94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-96" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="er3-94" target="er3-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-97" value="follows" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1200" y="860" width="140" height="80" as="geometry"/></mxCell><mxCell id="er3-98" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.95;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="er3-4" target="er3-97"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-99" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="er3-97" target="er3-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3-100" value='&lt;b&gt;Changes from V2&lt;/b&gt; (yellow), for the final project:&lt;br&gt;• &lt;b&gt;Student&lt;/b&gt; holds an account (email, hashed password) and the year they started, which decides which quarters are past. A student &lt;i&gt;owns&lt;/i&gt; any number of plans, each with a &lt;b&gt;name&lt;/b&gt;, to try "what if" scenarios. &lt;b&gt;Session&lt;/b&gt; keeps a student logged in.&lt;br&gt;• &lt;b&gt;share_token&lt;/b&gt; on DegreePlan makes a read-only link to share a plan with an advisor.&lt;br&gt;• &lt;b&gt;Program&lt;/b&gt; is the CS major, each CS emphasis, or the University Core (&lt;b&gt;kind&lt;/b&gt;). Requirements &lt;i&gt;belong to&lt;/i&gt; a program, and a plan &lt;i&gt;follows&lt;/i&gt; the emphasis the student chose.&lt;br&gt;• &lt;i&gt;contains&lt;/i&gt; drops &lt;b&gt;status&lt;/b&gt; (completed now comes from the date) and adds &lt;b&gt;failed&lt;/b&gt;, so a course can appear again when it is retaken.&lt;br&gt;• &lt;b&gt;OtherCredit&lt;/b&gt; is University Core, elective, AP/transfer or study abroad units (&lt;b&gt;kind&lt;/b&gt;), in a quarter or before SCU. It &lt;i&gt;counts toward&lt;/i&gt; requirements measured in &lt;b&gt;units&lt;/b&gt;.' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
