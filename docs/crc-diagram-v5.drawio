 how many of them are needed, units needed" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="crc5-46"><mxGeometry x="0" y="172" width="330" height="68" as="geometry"/></mxCell><mxCell id="crc5-52" value="Course" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1000" y="558" width="330" height="152" as="geometry"/></mxCell><mxCell id="crc5-53" value="Provide course description and prerequisite information" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc5-52"><mxGeometry x="0" y="30" width="330" height="44" as="geometry"/></mxCell><mxCell id="crc5-54" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc5-52"><mxGeometry x="0" y="74" width="330" height="10" as="geometry"/></mxCell><mxCell id="crc5-55" value="Knows: course code, title, units, description, prerequisite courses (any one course in an either/or group is enough)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="crc5-52"><mxGeometry x="0" y="84" width="330" height="68" as="geometry"/></mxCell><mxCell id="crc5-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-9" target="crc5-1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.05;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-35" target="crc5-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.27;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-41" target="crc5-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-41" target="crc5-46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-46" target="crc5-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-30" target="crc5-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-30" target="crc5-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.4;exitY=0;exitDx=0;exitDy=0;entryX=0.88;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-52" target="crc5-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-52" target="crc5-46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crc5-65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="crc5-52" target="crc5-35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="823"/><mxPoint x="160" y="823"/></Array></mxGeometry></mxCell><mxCell id="crc5-66" value="&lt;b&gt;Changes from V4&lt;/b&gt; (yellow), for the final project:&lt;br&gt;• &lt;b&gt;Student&lt;/b&gt;: accounts, the start quarter that decides which quarters are past, and any number of plans to try &quot;what if&quot; scenarios.&lt;br&gt;• &lt;b&gt;Program&lt;/b&gt;: groups requirements for the CS major, each CS emphasis, and the University Core. A plan follows the emphasis the student chose.&lt;br&gt;• &lt;b&gt;PlannedCourse&lt;/b&gt;: one attempt at a course in a quarter. Completed now comes from the date: once a quarter ends, the &lt;b&gt;Student&lt;/b&gt; confirms which courses they passed. A failed attempt lets the course be taken again.&lt;br&gt;• &lt;b&gt;OtherCredit&lt;/b&gt;: University Core, elective, AP/transfer and study abroad units, so a plan can reach 175 units.&lt;br&gt;• &lt;b&gt;DegreePlan&lt;/b&gt; projects when the plan finishes, says when the student is done, and makes a read-only link for an advisor. &lt;b&gt;Catalog&lt;/b&gt; finds prerequisite chains for the graph." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="858" width="1500" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
