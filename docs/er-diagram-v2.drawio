tex="1" parent="1"><mxGeometry x="1095" y="140" width="130" height="44" as="geometry"/></mxCell><mxCell id="c40" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="count" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1180" y="215" width="100" height="44" as="geometry"/></mxCell><mxCell id="c42" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="prerequisite_code" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=12;strokeColor=#d6b656;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="150" height="44" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="c9" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="prereq_group" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=12;strokeColor=#d6b656;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="740" y="700" width="140" height="44" as="geometry"/></mxCell><mxCell id="c46" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="c9" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Changes from V1&lt;/b&gt; (yellow) to match the database the backend uses:&lt;br&gt;• &lt;b&gt;Prerequisite&lt;/b&gt; replaces the Course–Course &lt;i&gt;requires&lt;/i&gt; relationship. A prerequisite option can be a course that isn&#x27;t offered (e.g. CSEN 79), so it stores the course code instead of a course_id. One course has many prerequisite rows; its key is (course_id, prerequisite_code, prereq_group).&lt;br&gt;• &lt;b&gt;position&lt;/b&gt; on &lt;i&gt;contains&lt;/i&gt; and &lt;i&gt;satisfies&lt;/i&gt; keeps the order of courses in a quarter and in a requirement." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="950" y="560" width="330" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>